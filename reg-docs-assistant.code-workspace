{
  // Multi-root workspace: each Python subproject is its own root folder so
  // each gets its own pytest rootdir (the folders still share flat module
  // names, so their tests can't run in one session yet). They all use the one
  // uv-managed .venv at the repo root: see the root pyproject.toml, and each
  // subfolder's .vscode/settings.json for the interpreter and pytest settings.
  // "repo root" is included so docs/, CLAUDE.md, CONTEXT.md, etc. stay visible
  // in the Explorer. Open THIS file (File > Open Workspace from File...)
  // instead of the bare folder.
  "folders": [
    {
      "name": "repo root",
      "path": "."
    },
    {
      "name": "schema",
      "path": "schema"
    },
    {
      "name": "ingestion",
      "path": "ingestion"
    },
    {
      "name": "store",
      "path": "store"
    },
    {
      "name": "eval",
      "path": "eval"
    },
    {
      "name": "track-b",
      "path": "track-b"
    }
  ],
  "settings": {
    // Root folder has no Python of its own; stop it running pytest from the
    // repo root (which would try to collect every subproject's tests with
    // whatever interpreter happened to be selected).
    "python.testing.pytestEnabled": false,
    "liveServer.settings.multiRootWorkspaceName": "repo root"
  },
  "extensions": {
    // Ruff formats Python on save in every subproject (see ruff.toml and each
    // subfolder's .vscode/settings.json). VS Code offers to install it.
    "recommendations": ["charliermarsh.ruff"]
  }
}
