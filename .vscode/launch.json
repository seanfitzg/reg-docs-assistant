{
  // Debug configurations for the eval harness (uses the root .venv via
  // settings.json). Needs Postgres up (docker compose up -d in store/) and
  // Ollama running with nomic-embed-text pulled -- see eval/README.md.
  "version": "0.2.0",
  "configurations": [
    {
      // The real eval: every Eval Case against the real `regdocs` store.
      // Note each run writes a new report into eval/runs/ -- delete any you
      // don't want to keep (only the baseline is committed).
      "name": "Run eval harness (real store)",
      "type": "debugpy",
      "request": "launch",
      "module": "regdocs_eval.run_eval",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      // The opt-in real-judge test (needs Ollama with qwen2.5:7b-instruct).
      // Set a breakpoint in the test or in regdocs_track_b/judge.py, then F5.
      "name": "Debug real judge test",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "track-b/tests/test_real_judge.py::test_the_real_judge_writes_claim_lines_that_code_can_read",
        "-s"
      ],
      "env": { "RUN_REAL_JUDGE": "1" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // The keyword-search authoring helper; edit "args" to change the search.
      "name": "Find locator",
      "type": "debugpy",
      "request": "launch",
      "module": "regdocs_eval.find_locator",
      "args": ["premium rebate"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
